generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  description String?
  image       String?
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
}
