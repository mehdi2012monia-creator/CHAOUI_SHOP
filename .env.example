# ===== متغيرات البيئة لنشر MEHDISHOP على Vercel =====
# انسخ هذه القيم إلى: Vercel ← Settings ← Environment Variables

# رابط قاعدة البيانات PostgreSQL (Neon أو Supabase) — إلزامي
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# نطاق المتجر النهائي (اتركه فارغاً ليكتشف النظام الرابط تلقائياً)
NEXT_PUBLIC_SITE_URL=https://chaouishop.app

# كلمة سر لحماية مسار تهيئة قاعدة البيانات /api/setup
SETUP_TOKEN=mehdi-secret-2026

# رمز التحقق من Google Search Console (اختياري — يمكن ضبطه من لوحة التحكم)
GOOGLE_SITE_VERIFICATION=
